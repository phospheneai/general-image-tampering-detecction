{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushOurImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:DescribeRepositories",
        "ecr:CreateRepository",
        "ecr:DescribeImages"
      ],
      "Resource": "arn:aws:ecr:${AWS_REGION}:${AWS_ACCOUNT_ID}:repository/forgery-train"
    },
    {
      "Sid": "PullTheAwsDlcBaseImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:*:763104351884:repository/*"
    },
    {
      "Sid": "ValidateDefinitions",
      "Effect": "Allow",
      "Action": "states:ValidateStateMachineDefinition",
      "Resource": "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:stateMachine:*"
    },
    {
      "Sid": "DeployAndStartThePipeline",
      "Effect": "Allow",
      "Action": [
        "states:CreateStateMachine",
        "states:UpdateStateMachine",
        "states:DescribeStateMachine",
        "states:StartExecution",
        "states:DescribeExecution"
      ],
      "Resource": [
        "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:stateMachine:forgery-*",
        "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:execution:forgery-*:*"
      ]
    },
    {
      "Sid": "PassTheStateMachineRoleWhenDeploying",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/forgery-stepfunctions-role",
      "Condition": { "StringEquals": { "iam:PassedToService": "states.amazonaws.com" } }
    },
    {
      "Sid": "ReportJobResultsInTheWorkflowSummary",
      "Effect": "Allow",
      "Action": ["sagemaker:DescribeTrainingJob", "logs:FilterLogEvents"],
      "Resource": [
        "arn:aws:sagemaker:${AWS_REGION}:${AWS_ACCOUNT_ID}:training-job/*",
        "arn:aws:logs:${AWS_REGION}:${AWS_ACCOUNT_ID}:log-group:/aws/sagemaker/TrainingJobs:*"
      ]
    },
    {
      "Sid": "PreflightCheckThatDataAndBackboneExist",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::authenta-data-rnd",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "image-tampering-detection/smoke/*",
            "image-tampering-detection/processed-v1/*",
            "image-tampering-detection/artifacts/*"
          ]
        }
      }
    }
  ]
}
